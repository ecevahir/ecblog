# Resend e-posta API anahtarı (resend.com üzerinden alın)
RESEND_API_KEY=

# Site URL (Vercel deploy sonrası güncelle)
NEXT_PUBLIC_SITE_URL=https://cevahir.web.tr

# Keystatic CMS — oturum çerezi imzalama anahtarı (min 32 karakter)
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEYSTATIC_SECRET=

# Keystatic GitHub OAuth App (GitHub Settings → Developer settings → OAuth Apps)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Keystatic depolama modu: production'da Vercel'e "github" olarak ekle, lokalde boş bırak
# Bu client-side'a da expose edilir (NEXT_PUBLIC_), bu yüzden GitHub login butonu görünür
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=
